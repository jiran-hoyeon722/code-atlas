{
    "name": "code-atlas",
    "private": true,
    "type": "module",
    "description": "Browser-only app that visualizes a local repository folder as a 3D dependency city, graph, and architecture explorer",
    "scripts": {
        "dev": "vite",
        "predev": "node scripts/copy-wasm.mjs",
        "build": "node scripts/copy-wasm.mjs && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "compare": "tsx scripts/compare.ts",
        "typecheck:engine": "tsc -p tsconfig.engine.json --noEmit",
        "e2e": "node scripts/e2e.mjs"
    },
    "dependencies": {
        "3d-force-graph": "1.80.0",
        "highlight.js": "^11.12.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "three": "^0.186.1",
        "tree-sitter-php": "0.24.2",
        "tree-sitter-typescript": "0.23.2",
        "typescript": "^5.9.0",
        "web-tree-sitter": "0.27.0"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react": "^6.1.1",
        "esbuild": "^0.28.2",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^29.1.1",
        "playwright-core": "^1.63.0",
        "tsx": "^4",
        "vite": "^8.3.1",
        "vitest": "^5"
    }
}
